    @overload
    def sinh[OutT: _data_matrix[Any, Any]](self: _CanAsFloat64[OutT], /) -> OutT: ...
    @overload
    def sinh(self, /) -> Self: ...
    #
    @overload
    def arcsinh[OutT: _data_matrix[Any, Any]](self: _CanAsFloat32[OutT], /) -> OutT: ...
    @overload
    def arcsinh[OutT: _data_matrix[Any, Any]](self: _CanAsFloat64[OutT], /) -> OutT: ...
    @overload
    def arcsinh(self, /) -> Self: ...
    #
    @overload
    def tan[OutT: _data_matrix[Any, Any]](self: _CanAsFloat32[OutT], /) -> OutT: ...
    @overload
    def tan[OutT: _data_matrix[Any, Any]](self: _CanAsFloat64[OutT], /) -> OutT: ...
    @overload
    def tan(self, /) -> Self: ...
    #
    @overload
    def arctan[OutT: _data_matrix[Any, Any]](self: _CanAsFloat32[OutT], /) -> OutT: ...
