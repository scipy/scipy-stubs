from collections.abc import Sequence
from typing import Any, Generic, Literal, Never, Protocol, Self, SupportsIndex, final, overload, override, type_check_only
from typing_extensions import TypeVar

import numpy as np
import optype.numpy as onp
import optype.numpy.compat as npc

from ._base import _spbase, sparray
from ._coo import coo_array, coo_matrix
from ._matrix import spmatrix
from ._sputils import _ScalarLike

__all__: list[str] = []

type _Scalar = npc.number | np.bool

_ScalarT_co = TypeVar("_ScalarT_co", bound=_Scalar, default=Any, covariant=True)
_ShapeT_co = TypeVar("_ShapeT_co", bound=tuple[int, *tuple[int, ...]], default=tuple[Any, ...], covariant=True)
_DataMatrixT_co = TypeVar("_DataMatrixT_co", bound=_data_matrix[Any, Any], covariant=True)

@final
@type_check_only
class _CanAsFloat32(Protocol[_DataMatrixT_co]):
    @property
    def dtype(self, /) -> np.dtype[npc.integer16]: ...
    @type_check_only
    def __assoc_as_float32__(self, /) -> _DataMatrixT_co: ...

@final
@type_check_only
class _CanAsFloat64(Protocol[_DataMatrixT_co]):
    @property
    def dtype(self, /) -> np.dtype[npc.integer32 | npc.integer64]: ...
    @type_check_only
    def __assoc_as_float64__(self, /) -> _DataMatrixT_co: ...

###

class _data_matrix(_spbase[_ScalarT_co, _ShapeT_co], Generic[_ScalarT_co, _ShapeT_co]):
    # NOTE: These two methods do not exist at runtime.
    @type_check_only
    def __assoc_as_float32__(self, /) -> _data_matrix[np.float32, _ShapeT_co]: ...
    @type_check_only
    def __assoc_as_float64__(self, /) -> _data_matrix[np.float64, _ShapeT_co]: ...

    #
    @property
    @override
    def format(self, /) -> Literal["bsr", "coo", "csc", "csr", "dia"]: ...

    #
    @property
    def dtype(self, /) -> np.dtype[_ScalarT_co]: ...
    @dtype.setter
    def dtype(self, newtype: Never, /) -> None: ...

    #
    @overload
    def __init__(
        self, /, arg1: _spbase[_ScalarT_co, _ShapeT_co] | onp.CanArrayND[_ScalarT_co, _ShapeT_co], *, maxprint: int | None = None
    ) -> None: ...
    @overload
    def __init__[ST: _Scalar](
        self: _data_matrix[ST, tuple[int]], /, arg1: Sequence[ST], *, maxprint: int | None = None
    ) -> None: ...
    @overload
    def __init__[ST: _Scalar](
        self: _data_matrix[ST, tuple[int, int]],
        /,
        arg1: Sequence[onp.CanArrayND[ST] | Sequence[ST]],
        *,
        maxprint: int | None = None,
    ) -> None: ...
    @overload
    def __init__(
        self: _data_matrix[np.float64, tuple[int]], /, arg1: tuple[SupportsIndex], *, maxprint: int | None = None
    ) -> None: ...
    @overload
    def __init__(
        self: _data_matrix[np.float64, tuple[int, int]],
        /,
        arg1: tuple[SupportsIndex, SupportsIndex],
        *,
        maxprint: int | None = None,
    ) -> None: ...
    @overload
    def __init__(self, /, arg1: onp.CanArrayND[_ScalarT_co], *, maxprint: int | None = None) -> None: ...

    #
    @override
    def __imul__(self, rhs: _ScalarLike, /) -> Self: ...  # type: ignore[override]
    @override
    def __itruediv__(self, rhs: _ScalarLike, /) -> Self: ...  # type: ignore[override]

    # NOTE: The following methods do not convert the scalar type
    def sign(self, /) -> Self: ...
    def ceil(self, /) -> Self: ...
    def floor(self, /) -> Self: ...
    def rint(self, /) -> Self: ...
    def trunc(self, /) -> Self: ...

    #
    @overload
    def sqrt[OutT: _data_matrix[Any, Any]](self: _CanAsFloat32[OutT], /) -> OutT: ...
    @overload
    def sqrt[OutT: _data_matrix[Any, Any]](self: _CanAsFloat64[OutT], /) -> OutT: ...
    @overload
    def sqrt(self, /) -> Self: ...

    #
    @overload
    def expm1[OutT: _data_matrix[Any, Any]](self: _CanAsFloat32[OutT], /) -> OutT: ...
    @overload
    def expm1[OutT: _data_matrix[Any, Any]](self: _CanAsFloat64[OutT], /) -> OutT: ...
    @overload
    def expm1(self, /) -> Self: ...
    #
    @overload
    def log1p[OutT: _data_matrix[Any, Any]](self: _CanAsFloat32[OutT], /) -> OutT: ...
    @overload
    def log1p[OutT: _data_matrix[Any, Any]](self: _CanAsFloat64[OutT], /) -> OutT: ...
    @overload
    def log1p(self, /) -> Self: ...

    #
    @overload
    def sin[OutT: _data_matrix[Any, Any]](self: _CanAsFloat32[OutT], /) -> OutT: ...
    @overload
    def sin[OutT: _data_matrix[Any, Any]](self: _CanAsFloat64[OutT], /) -> OutT: ...
    @overload
    def sin(self, /) -> Self: ...
    #
    @overload
