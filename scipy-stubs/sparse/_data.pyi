class _minmax_mixin(Generic[_ScalarT_co, _ShapeT_co]):
    # NOTE: The following 4 methods have identical signatures
    @overload  # axis: None = ..., out: None = ...
    def max(self, /, axis: None = None, out: None = None, *, explicit: bool = False) -> _ScalarT_co: ...
    @overload  # 1-d, axis: int, out: None = ...
    def max[ST: _Scalar](
        self: _minmax_mixin[ST, tuple[int]], /, axis: onp.ToInt | None = None, out: None = None, *, explicit: bool = False
    ) -> ST: ...
    @overload  # sparray, axis: int, out: None = ...
    def max[ST: _Scalar](  # type: ignore[misc]
        self: sparray[ST],  # zuban: ignore[misc]
        /,
        axis: onp.ToInt,
        out: None = None,
        *,
        explicit: bool = False,
    ) -> coo_array[ST, tuple[int]]: ...
    @overload  # spmatrix, axis: int, out: None = ...
    def max[ST: _Scalar](  # type: ignore[misc]
        self: spmatrix[ST],  # zuban: ignore[misc]
        /,
        axis: onp.ToInt,
        out: None = None,
        *,
        explicit: bool = False,
    ) -> coo_matrix[ST]: ...
    #
    @overload  # axis: None = ..., out: None = ...
    def nanmax(self, /, axis: None = None, out: None = None, *, explicit: bool = False) -> _ScalarT_co: ...
    @overload  # 1-d, axis: int, out: None = ...
    def nanmax[ST: _Scalar](
        self: _minmax_mixin[ST, tuple[int]], /, axis: onp.ToInt | None = None, out: None = None, *, explicit: bool = False
    ) -> ST: ...
    @overload  # sparray, axis: int, out: None = ...
    def nanmax[ST: _Scalar](  # type: ignore[misc]
        self: sparray[ST],  # zuban: ignore[misc]
        /,
        axis: onp.ToInt,
        out: None = None,
        *,
        explicit: bool = False,
    ) -> coo_array[ST, tuple[int]]: ...
    @overload  # spmatrix, axis: int, out: None = ...
    def nanmax[ST: _Scalar](  # type: ignore[misc]
        self: spmatrix[ST],  # zuban: ignore[misc]
        /,
        axis: onp.ToInt,
        out: None = None,
        *,
        explicit: bool = False,
    ) -> coo_matrix[ST]: ...
    #
    @overload  # axis: None = ..., out: None = ...
    def min(self, /, axis: None = None, out: None = None, *, explicit: bool = False) -> _ScalarT_co: ...
    @overload  # 1-d, axis: int, out: None = ...
    def min[ST: _Scalar](
        self: _minmax_mixin[ST, tuple[int]], /, axis: onp.ToInt | None = None, out: None = None, *, explicit: bool = False
    ) -> ST: ...
    @overload  # sparray, axis: int, out: None = ...
    def min[ST: _Scalar](  # type: ignore[misc]
        self: sparray[ST],  # zuban: ignore[misc]
        /,
        axis: onp.ToInt,
        out: None = None,
        *,
        explicit: bool = False,
    ) -> coo_array[ST, tuple[int]]: ...
    @overload  # spmatrix, axis: int, out: None = ...
    def min[ST: _Scalar](  # type: ignore[misc]
        self: spmatrix[ST],  # zuban: ignore[misc]
        /,
        axis: onp.ToInt,
        out: None = None,
        *,
        explicit: bool = False,
    ) -> coo_matrix[ST]: ...
    #
    @overload  # axis: None = ..., out: None = ...
    def nanmin(self, /, axis: None = None, out: None = None, *, explicit: bool = False) -> _ScalarT_co: ...
    @overload  # 1-d, axis: int, out: None = ...
    def nanmin[ST: _Scalar](
        self: _minmax_mixin[ST, tuple[int]], /, axis: onp.ToInt | None = None, out: None = None, *, explicit: bool = False
    ) -> ST: ...
    @overload  # sparray, axis: int, out: None = ...
    def nanmin[ST: _Scalar](  # type: ignore[misc]
