__all__ = ["SparseEfficiencyWarning", "SparseWarning", "issparse", "isspmatrix", "sparray"]

###

type _1D = tuple[int]  # ruff: ignore[snake-case-type-alias]
type _2D = tuple[int, int]  # ruff: ignore[snake-case-type-alias]

type _ToInt8 = np.bool | np.int8
type _ToInt16 = np.bool | npc.integer8 | npc.integer16
type _ToInt = npc.integer | np.bool
type _ToFloat32 = np.float32 | _ToInt
type _ToFloat = npc.floating | _ToInt
type _ToComplex64 = np.complex64 | _ToFloat
type _Scalar = npc.number | np.bool

type _ToSparseSeq[T] = Sequence[Sequence[T]] | Sequence[T]
type _ToSparseArray[ST: _Scalar] = onp.CanArrayND[ST] | _ToSparseSeq[ST]

type _SpMatrix[ST: _Scalar] = (
    bsr_matrix[ST] | coo_matrix[ST] | csc_matrix[ST] | csr_matrix[ST] | dia_matrix[ST] | dok_matrix[ST] | lil_matrix[ST]
)
type _SpMatrixOut[ST: _Scalar] = bsr_matrix[ST] | csc_matrix[ST] | csr_matrix[ST]

type _SpArray1D[ST: _Scalar] = coo_array[ST, _1D] | csr_array[ST, _1D] | dok_array[ST, _1D]
type _SpArray2D[ST: _Scalar] = (
    bsr_array[ST] | coo_array[ST, _2D] | csc_array[ST] | csr_array[ST, _2D] | dia_array[ST] | dok_array[ST, _2D] | lil_array[ST]
)

type _SpArrayOut[ST: _Scalar] = bsr_array[ST] | csc_array[ST] | csr_array[ST]

type _NeitherD = tuple[Never] | tuple[Never, Never]
type _NonCSCArray2D[ST: _Scalar] = (
    bsr_array[ST] | coo_array[ST, _2D] | csr_array[ST, _2D] | dia_array[ST] | dok_array[ST, _2D] | lil_array[ST]
)
type _NonCSCMatrix[ST: _Scalar] = (
    bsr_matrix[ST] | coo_matrix[ST] | csr_matrix[ST] | dia_matrix[ST] | dok_matrix[ST] | lil_matrix[ST]
)

type _ToCSRArray[ST: _Scalar] = coo_array[ST] | csr_array[ST] | dia_array[ST] | dok_array[ST]
type _ToCSRMatrix[ST: _Scalar] = coo_matrix[ST] | csr_matrix[ST] | dia_matrix[ST] | dok_matrix[ST]

type _SparseLike[T, ST: _Scalar] = T | ST | _spbase[ST]
type _To2DLike[T, ST: _Scalar] = Sequence[T | ST] | Sequence[Sequence[T | ST] | onp.CanArrayND[ST]] | onp.CanArrayND[ST]

type _BinOp = Callable[[object, object], Any]

type _Casting = L["no", "equiv", "safe", "same_kind", "unsafe"]

type _StackedSparseArray[ST: _Scalar] = coo_array[ST, _2D] | csc_array[ST] | csr_array[ST, _2D]

_T_co = TypeVar("_T_co", covariant=True)
_ScalarT_co = TypeVar("_ScalarT_co", bound=_Scalar, default=Any, covariant=True)
_ShapeT_co = TypeVar("_ShapeT_co", bound=tuple[int, *tuple[int, ...]], default=tuple[Any, ...], covariant=True)

_IntT = TypeVar("_IntT", bound=npc.integer, default=np.int_)
_FloatT = TypeVar("_FloatT", bound=npc.floating, default=np.float64)
_Float64T = TypeVar("_Float64T", bound=np.float64 | npc.floating80, default=np.float64)
_ComplexT = TypeVar("_ComplexT", bound=npc.complexfloating, default=np.complex128)
_Complex64T = TypeVar("_Complex64T", bound=npc.complexfloating, default=np.complex64)
_Complex128T = TypeVar("_Complex128T", bound=np.complex128 | npc.complexfloating160, default=np.complex128)

# Used to emulate `@property` overloading in `_spbase.T`
@type_check_only
class _CanTranspose(Protocol[_T_co]):
    def transpose(self, /) -> _T_co: ...

@final
@type_check_only
class _CanAsFloat64[ST: _Scalar, OutT](Protocol):
    @property
    def dtype(self, /) -> np.dtype[ST]: ...
    @type_check_only
    def __assoc_as_float64__(self, /) -> OutT: ...

@final
@type_check_only
class _CanAsComplex128[ST: _Scalar, OutT](Protocol):
    @property
    def dtype(self, /) -> np.dtype[ST]: ...
    @type_check_only
    def __assoc_as_complex128__(self, /) -> OutT: ...

###

_formats: Final[dict[str, list[int | str]]] = ...  # undocumented
_ufuncs_with_fixed_point_at_zero: Final[frozenset[np.ufunc]] = ...  # undocumented

MAXPRINT: Final = 50  # undocumented

op_neg: Final[dict[_BinOp, _BinOp]] = ...  # undocumented
op_sym: Final[dict[_BinOp, str]] = ...  # undocumented

class SparseWarning(Warning): ...
class SparseFormatWarning(SparseWarning): ...
class SparseEfficiencyWarning(SparseWarning): ...

class _spbase(SparseABC, Generic[_ScalarT_co, _ShapeT_co]):
    __array_priority__: ClassVar[float] = 10.1
    _format: ClassVar[str] = "und"
    _allow_nd: ClassVar[Sequence[int]] = (2,)  # will be either a `tuple[int, ...]` or a `builtins.range` instance

    maxprint: Final[int | None]

    # NOTE: These `__assoc_*__` methods do not exist at runtime!
    # We use it to emulate polymorphic associated types, which allows functions such as `hstack` and `block_array` to accurately
    # annotate their return types.
    # Overloads cannot be used due to limitations in the constraint matching algorithms of the supported static type checkers.
    @type_check_only  # same kind, same scalar-type, 2d shape-type
    def __assoc_stacked__(self, /) -> _spbase[_ScalarT_co, _2D]: ...
    @type_check_only  # same kind, mapped scalar-type, 2d shape-type
    def __assoc_stacked_as__[ST: _Scalar](self, sctype: ST, /) -> _spbase[ST, _2D]: ...
    @type_check_only  # same kind, `Any` scalar-type, same shape-type  (mypy (2.2.0) can't deal with generic sctype)
    def __assoc_as_any__(self, /) -> _spbase[Any, _ShapeT_co]: ...

    #
    @property
    def ndim(self, /) -> int: ...
    @property
    def shape(self, /) -> _ShapeT_co: ...
    @property
    def nnz(self, /) -> int: ...
    @property
    def size(self, /) -> int: ...

    # abstract-ish
    @property
    def format(self, /) -> _Format: ...

    #
    @property
    def real(self, /) -> Self: ...
    @property
    def imag(self, /) -> Self: ...

    #
    @overload  # shape
    def __init__(
        self: _spbase[np.float64], /, arg1: tuple[SupportsIndex, *tuple[SupportsIndex, ...]], *, maxprint: int | None = None
    ) -> None: ...
    @overload  # sparse
    def __init__(self, /, arg1: _spbase[_ScalarT_co], *, maxprint: int | None = None) -> None: ...
    @overload  # dense array-like
    def __init__(self, /, arg1: _ToSparseArray[_ScalarT_co], *, maxprint: int | None = None) -> None: ...
    @overload  # dense array-like bool
    def __init__(self: _spbase[np.bool], /, arg1: _ToSparseSeq[bool], *, maxprint: int | None = None) -> None: ...
    @overload  # dense array-like int
    def __init__(self: _spbase[np.int_], /, arg1: _ToSparseSeq[op.JustInt], *, maxprint: int | None = None) -> None: ...
    @overload  # dense array-like float
    def __init__(self: _spbase[np.float64], /, arg1: _ToSparseSeq[op.JustFloat], *, maxprint: int | None = None) -> None: ...
    @overload  # dense array-like cfloat
    def __init__(self: _spbase[np.complex128], /, arg1: _ToSparseSeq[op.JustComplex], *, maxprint: int | None = None) -> None: ...

    #
    def __bool__(self, /) -> bool: ...

    # only `dok_*` doesn't raise `TypeError` when passed to `len`
    def __len__(self: dok_array | dok_matrix, /) -> int: ...  # pyright: ignore[reportGeneralTypeIssues]

    #
    @overload  # 1-d {csr,dok}_array
    def __iter__[ST: _Scalar](self: csr_array[ST, _1D] | dok_array[ST, _1D], /) -> Iterator[ST]: ...
    @overload  # 2-d {csc,csr}_array
    def __iter__[ST: _Scalar](self: csc_array[ST] | csr_array[ST, _2D], /) -> Iterator[csr_array[ST, _1D]]: ...
    @overload  # lil_array
    def __iter__[ST: _Scalar](self: lil_array[ST], /) -> Iterator[coo_array[ST, _1D]]: ...
    @overload  # {csc,csr}_matrix
    def __iter__[ST: _Scalar](self: csc_matrix[ST] | csr_matrix[ST], /) -> Iterator[csr_matrix[ST]]: ...
    @overload  # dok_matrix
    def __iter__[ST: _Scalar](self: dok_matrix[ST], /) -> Iterator[dok_matrix[ST]]: ...
    @overload  # lil_matrix
    def __iter__[ST: _Scalar](self: lil_matrix[ST], /) -> Iterator[lil_matrix[ST]]: ...

    # keep in sync with `__ne__`
    @overload  # csc_array, sparse 2d | scalar
    def __eq__(self: csc_array[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_array[np.bool]: ...
    @overload  # sparray ?d, sparse | scalar  (workaround)
    def __eq__(self: sparray[Any, _NeitherD], other: _spbase | onp.ToComplex, /) -> _spbase[np.bool, tuple[Any, ...]]: ...
    @overload  # sparray 2d, sparse 2d | scalar
    def __eq__(self: _NonCSCArray2D[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_array[np.bool, _2D]: ...
    @overload  # sparray 1d, sparse 1d | scalar
    def __eq__(self: _SpArray1D[Any], other: _spbase[Any, _1D] | onp.ToComplex, /) -> csr_array[np.bool, _1D]: ...
    @overload  # csc_matrix, sparse 2d | scalar
    def __eq__(self: csc_matrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_matrix[np.bool]: ...
    @overload  # spmatrix, sparse 2d | scalar
    def __eq__(self: _NonCSCMatrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_matrix[np.bool]: ...
    @overload  # sparray, dense
    def __eq__(self: sparray, other: onp.ToComplexND, /) -> onp.ArrayND[np.bool]: ...
    @overload  # spmatrix, dense
    def __eq__(self: spmatrix, other: onp.ToComplexND, /) -> onp.Matrix[np.bool]: ...
    @overload  # fallback
    def __eq__(self, other: object, /) -> Any: ...

    # keep in sync with `__eq__`
    @overload  # csc_array, sparse 2d | scalar
    def __ne__(self: csc_array[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_array[np.bool]: ...
    @overload  # sparray ?d, sparse | scalar  (workaround)
    def __ne__(self: sparray[Any, _NeitherD], other: _spbase | onp.ToComplex, /) -> _spbase[np.bool, tuple[Any, ...]]: ...
    @overload  # sparray 2d, sparse 2d | scalar
    def __ne__(self: _NonCSCArray2D[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_array[np.bool, _2D]: ...
    @overload  # sparray 1d, sparse 1d | scalar
    def __ne__(self: _SpArray1D[Any], other: _spbase[Any, _1D] | onp.ToComplex, /) -> csr_array[np.bool, _1D]: ...
    @overload  # csc_matrix, sparse 2d | scalar
    def __ne__(self: csc_matrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_matrix[np.bool]: ...
    @overload  # spmatrix, sparse 2d | scalar
    def __ne__(self: _NonCSCMatrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_matrix[np.bool]: ...
    @overload  # sparray, dense
    def __ne__(self: sparray, other: onp.ToComplexND, /) -> onp.ArrayND[np.bool]: ...
    @overload  # spmatrix, dense
    def __ne__(self: spmatrix, other: onp.ToComplexND, /) -> onp.Matrix[np.bool]: ...
    @overload  # fallback
    def __ne__(self, other: object, /) -> Any: ...

    # keep in sync with `__gt__`, `__le__` and `__ge__`
    @overload  # csc_array, sparse 2d | scalar
    def __lt__(self: csc_array[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_array[np.bool]: ...
    @overload  # sparray ?d, sparse | scalar  (workaround)
    def __lt__(self: sparray[Any, _NeitherD], other: _spbase | onp.ToComplex, /) -> _spbase[np.bool, tuple[Any, ...]]: ...
    @overload  # sparray 2d, sparse 2d | scalar
    def __lt__(self: _NonCSCArray2D[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_array[np.bool, _2D]: ...
    @overload  # sparray 1d, sparse 1d | scalar
    def __lt__(self: _SpArray1D[Any], other: _spbase[Any, _1D] | onp.ToComplex, /) -> csr_array[np.bool, _1D]: ...
    @overload  # csc_matrix, sparse 2d | scalar
    def __lt__(self: csc_matrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_matrix[np.bool]: ...
    @overload  # spmatrix, sparse 2d | scalar
    def __lt__(self: _NonCSCMatrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_matrix[np.bool]: ...
    @overload  # sparse, sparse | scalar
    def __lt__[ShapeT: tuple[Any, ...]](
        self: _spbase[Any, ShapeT], other: _spbase[Any, ShapeT] | onp.ToComplex, /
    ) -> _spbase[np.bool, ShapeT]: ...
    @overload  # sparray, dense
    def __lt__(self: sparray, other: onp.ToComplexND, /) -> onp.ArrayND[np.bool]: ...
    @overload  # spmatrix, dense
    def __lt__(self: spmatrix, other: onp.ToComplexND, /) -> onp.Matrix[np.bool]: ...

    # keep in sync with `__lt__`, `__le__` and `__ge__`
    @overload  # csc_array, sparse 2d | scalar
    def __gt__(self: csc_array[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_array[np.bool]: ...
    @overload  # sparray ?d, sparse | scalar  (workaround)
    def __gt__(self: sparray[Any, _NeitherD], other: _spbase | onp.ToComplex, /) -> _spbase[np.bool, tuple[Any, ...]]: ...
    @overload  # sparray 2d, sparse 2d | scalar
    def __gt__(self: _NonCSCArray2D[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_array[np.bool, _2D]: ...
    @overload  # sparray 1d, sparse 1d | scalar
    def __gt__(self: _SpArray1D[Any], other: _spbase[Any, _1D] | onp.ToComplex, /) -> csr_array[np.bool, _1D]: ...
    @overload  # csc_matrix, sparse 2d | scalar
    def __gt__(self: csc_matrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_matrix[np.bool]: ...
    @overload  # spmatrix, sparse 2d | scalar
    def __gt__(self: _NonCSCMatrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_matrix[np.bool]: ...
    @overload  # sparse, sparse | scalar
    def __gt__[ShapeT: tuple[Any, ...]](
        self: _spbase[Any, ShapeT], other: _spbase[Any, ShapeT] | onp.ToComplex, /
    ) -> _spbase[np.bool, ShapeT]: ...
    @overload  # sparray, dense
    def __gt__(self: sparray, other: onp.ToComplexND, /) -> onp.ArrayND[np.bool]: ...
    @overload  # spmatrix, dense
    def __gt__(self: spmatrix, other: onp.ToComplexND, /) -> onp.Matrix[np.bool]: ...

    # keep in sync with `__lt__`, `__gt__` and `__ge__`
    @overload  # csc_array, sparse 2d | scalar
    def __le__(self: csc_array[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_array[np.bool]: ...
    @overload  # sparray ?d, sparse | scalar  (workaround)
    def __le__(self: sparray[Any, _NeitherD], other: _spbase | onp.ToComplex, /) -> _spbase[np.bool, tuple[Any, ...]]: ...
    @overload  # sparray 2d, sparse 2d | scalar
    def __le__(self: _NonCSCArray2D[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_array[np.bool, _2D]: ...
    @overload  # sparray 1d, sparse 1d | scalar
    def __le__(self: _SpArray1D[Any], other: _spbase[Any, _1D] | onp.ToComplex, /) -> csr_array[np.bool, _1D]: ...
    @overload  # csc_matrix, sparse 2d | scalar
    def __le__(self: csc_matrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_matrix[np.bool]: ...
    @overload  # spmatrix, sparse 2d | scalar
    def __le__(self: _NonCSCMatrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_matrix[np.bool]: ...
    @overload  # sparse, sparse | scalar
    def __le__[ShapeT: tuple[Any, ...]](
        self: _spbase[Any, ShapeT], other: _spbase[Any, ShapeT] | onp.ToComplex, /
    ) -> _spbase[np.bool, ShapeT]: ...
    @overload  # sparray, dense
    def __le__(self: sparray, other: onp.ToComplexND, /) -> onp.ArrayND[np.bool]: ...
    @overload  # spmatrix, dense
    def __le__(self: spmatrix, other: onp.ToComplexND, /) -> onp.Matrix[np.bool]: ...

    # keep in sync with `__lt__`, `__gt__` and `__le__`
    @overload  # csc_array, sparse 2d | scalar
    def __ge__(self: csc_array[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_array[np.bool]: ...
    @overload  # sparray ?d, sparse | scalar  (workaround)
    def __ge__(self: sparray[Any, _NeitherD], other: _spbase | onp.ToComplex, /) -> _spbase[np.bool, tuple[Any, ...]]: ...
    @overload  # sparray 2d, sparse 2d | scalar
    def __ge__(self: _NonCSCArray2D[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_array[np.bool, _2D]: ...
    @overload  # sparray 1d, sparse 1d | scalar
    def __ge__(self: _SpArray1D[Any], other: _spbase[Any, _1D] | onp.ToComplex, /) -> csr_array[np.bool, _1D]: ...
    @overload  # csc_matrix, sparse 2d | scalar
    def __ge__(self: csc_matrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csc_matrix[np.bool]: ...
    @overload  # spmatrix, sparse 2d | scalar
    def __ge__(self: _NonCSCMatrix[Any], other: _spbase[Any, _2D] | onp.ToComplex, /) -> csr_matrix[np.bool]: ...
    @overload  # sparse, sparse | scalar
    def __ge__[ShapeT: tuple[Any, ...]](
        self: _spbase[Any, ShapeT], other: _spbase[Any, ShapeT] | onp.ToComplex, /
    ) -> _spbase[np.bool, ShapeT]: ...
    @overload  # sparray, dense
    def __ge__(self: sparray, other: onp.ToComplexND, /) -> onp.ArrayND[np.bool]: ...
    @overload  # spmatrix, dense
    def __ge__(self: spmatrix, other: onp.ToComplexND, /) -> onp.Matrix[np.bool]: ...

    #
    def __neg__(self, /) -> Self: ...
    def __abs__(self, /) -> Self: ...
    def __round__(self, /, ndigits: int = 0) -> Self: ...

    #
    @overload  # `0` or sparse of same dtype
    def __add__(self, other: onp.ToFalse | _spbase[_ScalarT_co], /) -> Self: ...
    @overload  # sparse[-Int], sparse[+Int8]
    def __add__[SpNumberT: _spbase[npc.number]](self: SpNumberT, other: _spbase[_ToInt8], /) -> SpNumberT: ...
    @overload  # sparse[-Float], sparse[+Float32]
    def __add__[SpInexactT: _spbase[npc.inexact]](self: SpInexactT, other: _spbase[_ToFloat32], /) -> SpInexactT: ...
    @overload  # sparse[-Complex], sparse[+Complex64]
    def __add__[SpComplexT: _spbase[npc.complexfloating]](self: SpComplexT, other: _spbase[_ToComplex64], /) -> SpComplexT: ...
    @overload  # sparse[?], sparse[?]
    def __add__[OutT: _spbase[Any, Any]](self: _CanAsAny[OutT], other: _spbase[Any], /) -> OutT: ...
    @overload  # spmatrix[-Int], array[+Int8]
    def __add__[ST: npc.number](self: spmatrix[ST], other: onp.ArrayND[_ToInt8], /) -> onp.Matrix[ST]: ...
    @overload  # spmatrix[-Float], array[+Float32]
    def __add__[ST: npc.inexact](self: spmatrix[ST], other: onp.ArrayND[_ToFloat32], /) -> onp.Matrix[ST]: ...
    @overload  # spmatrix[-Complex], array[+Complex64]
    def __add__[ST: npc.complexfloating](self: spmatrix[ST], other: onp.ArrayND[_ToComplex64], /) -> onp.Matrix[ST]: ...
    @overload  # sparse[-Int], array[+Int8]
    def __add__[ST: npc.number, ShapeT: tuple[Any, ...]](
        self: _spbase[ST, ShapeT], other: onp.ArrayND[_ToInt8], /
    ) -> onp.ArrayND[ST, ShapeT]: ...
    @overload  # sparse[-Float], array[+Float32]
    def __add__[ST: npc.inexact, ShapeT: tuple[Any, ...]](
        self: _spbase[ST, ShapeT], other: onp.ArrayND[_ToFloat32], /
    ) -> onp.ArrayND[ST, ShapeT]: ...
    @overload  # sparse[-Complex], array[+Complex64]
    def __add__[ST: npc.complexfloating, ShapeT: tuple[Any, ...]](
        self: _spbase[ST, ShapeT], other: onp.ArrayND[_ToComplex64], /
    ) -> onp.ArrayND[ST, ShapeT]: ...
    @overload  # sparse[?], array[?]
    def __add__(self, other: onp.ArrayND[_Scalar], /) -> onp.ArrayND[Any, _ShapeT_co]: ...

    #
    @overload  # `0` or sparse of same dtype
    def __sub__(self, other: onp.ToFalse | _spbase[_ScalarT_co], /) -> Self: ...
    @overload  # sparse[-Int], sparse[+Int8]
    def __sub__[SpNumberT: _spbase[npc.number]](self: SpNumberT, other: _spbase[_ToInt8], /) -> SpNumberT: ...
    @overload  # sparse[-Float], sparse[+Float32]
    def __sub__[SpInexactT: _spbase[npc.inexact]](self: SpInexactT, other: _spbase[_ToFloat32], /) -> SpInexactT: ...
    @overload  # sparse[-Complex], sparse[+Complex64]
    def __sub__[SpComplexT: _spbase[npc.complexfloating]](self: SpComplexT, other: _spbase[_ToComplex64], /) -> SpComplexT: ...
    @overload  # sparse[?], sparse[?]
    def __sub__[OutT: _spbase[Any, Any]](self: _CanAsAny[OutT], other: _spbase[Any], /) -> OutT: ...
    @overload  # spmatrix[-Int], array[+Int8]
