def zeta(x: npc.complexfloating128, q: onp.ToFloat | None = None, out: None = None) -> np.complex128: ...
@overload  # ~complex, +f64
def zeta(
    x: op.JustComplex, q: float | npc.integer | np.bool | npc.floating80 | None = None, out: None = None
