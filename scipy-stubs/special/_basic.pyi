def zeta[ArrayT: onp.ArrayND](x: _ToComplexOrND, q: _ToFloatOrND | None = None, *, out: ArrayT) -> ArrayT: ...
@overload  # ~f32
def zeta(x: npc.floating32 | npc.floating16, q: _ToF32 | None = None, out: None = None) -> np.float32: ...
