type _ToIntOrND = onp.ToInt | onp.ToIntND
type _ToFloatOrND = onp.ToFloat | onp.ToFloatND
type _ToComplexOrND = onp.ToComplex | onp.ToComplexND
type _ToJustComplexOrND = onp.ToJustComplex | onp.ToJustComplexND

type _AsF64 = np.float64 | npc.integer64 | npc.integer32
type _ToF32 = onp.ToFloat32 | op.JustFloat | int

type _Extend0 = L["zero"]
type _ExtendC = L["complex"]
type _Extend = L[_Extend0, _ExtendC]

# ruff: file-ignore[snake-case-type-alias]
type _tuple2[T] = tuple[T, T]
type _tuple4[T0, T1] = tuple[T0, T1, T1, T1]
type _tuple8[T0, T1] = tuple[T0, T1, T1, T1, T1, T1, T1, T1]

type _i = np.int32 | np.int64

type _f8_1d = onp.Array1D[np.float64]
type _f8_2d = onp.Array2D[np.float64]
type _f8_nd = onp.ArrayND[np.float64]
type _c8_1d = onp.Array1D[np.complex128]
type _c8_2d = onp.Array2D[np.complex128]
type _c8_nd = onp.ArrayND[np.complex128]

# workaround for a strange bug in pyright's overlapping overload detection with `numpy<2.1`
type _WorkaroundForPyright = tuple[int] | tuple[Any, ...]

