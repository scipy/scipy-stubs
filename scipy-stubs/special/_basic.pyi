@overload  # fallback
def zeta(x: onp.ToComplex, q: onp.ToFloat | None = None, out: None = None) -> np.float64 | Any: ...
@overload  # Nd fallback
def zeta(x: onp.ToComplexND, q: _ToFloatOrND | None = None, out: None = None) -> onp.ArrayND[np.float64 | Any]: ...
