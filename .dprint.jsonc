{
  "json": {
    "lineWidth": 100,
    "array.preferSingleLine": true,
    "jsonTrailingCommaFiles": [".vscode/extensions.json", ".vscode/settings.json"],
  },
  "markdown": {
    "lineWidth": 200,
    "emphasisKind": "asterisks",
  },
  "toml": {
    "lineWidth": 100,
  },
  "yaml": {
    "printWidth": 100,
    "formatComments": true,
    "braceSpacing": false,
  },
  "excludes": ["**/*-lock.json", "**/*.lock", "**/node_modules/", "dist/"],
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.1",
    "npm:@dprint/toml@0.8.0",
  ],
}
